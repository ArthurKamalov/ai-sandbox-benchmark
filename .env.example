OPENAI_API_KEY=

# Daytona Production Environment
DAYTONA_SERVER_URL=https://app.daytona.io/api
DAYTONA_API_KEY=

# Daytona Staging Environment
DAYTONA_STAGE_SERVER_URL=https://stage.daytona.work/api
DAYTONA_STAGE_API_KEY=

# Use staging environment (true/false)
USE_DAYTONA_STAGE=false

E2B_API_KEY=
CSB_API_KEY=

# Agent Substrate (via agent-substrate/env); all optional, see providers/README.md
# ate-env-api address, e.g. a kubectl port-forward (default: localhost:7777)
SUBSTRATE_ENV_API_ADDR=
# Registered template, '<name>' or '<atespace>/<name>' (default: ate-env-api's default template)
SUBSTRATE_TEMPLATE=
# Atespace to create environments in (default: ate-env)
SUBSTRATE_ATESPACE=
# Digest-pinned rootfs image; prefer SUBSTRATE_TEMPLATE for benchmarks
SUBSTRATE_ROOTFS_IMAGE=
# Directory for test code inside the environment (default: /workspace)
SUBSTRATE_WORKDIR=
